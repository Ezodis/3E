(defcfg
  ;; All Clicks key events must reach one-shot processing so any next key consumes it.
  process-unmapped-keys yes
  windows-interception-keyboard-hwids (
    "{{POWER_KEYBOARD_HWID}}"
  )
)

;; The hardware filter above restricts this profile to the Clicks keyboard.
(defsrc
  lctl lmet lalt k tab lsft rsft
)

(defalias
  ctrl-key {{CTRL_AS_ALT}}
  command-key (tap-dance-eager 350 (
    (one-shot-release 5000 {{COMMAND_AS_CTRL}})
    (multi
      (release-key {{COMMAND_AS_CTRL}})
      (release-key lsft)
      (release-key rsft)
      lmet h)
  ))
  shift-key (one-shot-release 5000 lsft)
  right-shift-key (one-shot-release 5000 rsft)
  triangle-layer (layer-while-held power-special)
)

(deflayer base
  @ctrl-key @command-key @triangle-layer k tab @shift-key @right-shift-key
)

;; Use the keyboard's Android mode for Windows.
;; The labeled Ctrl key emits Right Alt; the red Clicks Tab input is unchanged.
;; Right Alt avoids the global left-Alt shortcut remaps and scan-code swap.
;; Command emits right Ctrl, unaffected by the old system left Alt/Ctrl swap.
;; Mac keyboard layout translates it to Command shortcuts while enabled.
;; Tap Command or Shift for the next key, or hold for normal modifier behavior.
;; Sequential Command/Shift taps combine and restart the five-second timeout.
;; Double-tap Command releases pending Ctrl/Shift before Windows+H dictation.

;; The six-dot/triangle key reports Alt+K. Emit Windows for that sequence.
;; An ordinary K remains K; the red Clicks key remains Tab in either layer.
(deflayer power-special
  _ _ _ lmet tab _ _
)
